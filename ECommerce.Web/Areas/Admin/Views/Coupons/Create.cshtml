@model ECommerce.Web.ViewModels.AdminCreateCouponViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Coupon";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🏷️ Create Coupon</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to coupons</a>
</div>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

<form asp-action="Create" method="post">
    <div class="row g-4">
        <div class="col-md-7">
            <div class="card mb-3">
                <div class="card-header fw-bold">Coupon details</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Code</label>
                        <input asp-for="Coupon.Code" class="form-control text-uppercase" placeholder="e.g. SUMMER25" />
                        <span asp-validation-for="Coupon.Code" class="text-danger"></span>
                        <div class="form-text">Stored uppercase automatically. Customers type this at checkout.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Coupon.Description" class="form-control" rows="2" placeholder="Internal note — not shown to customers"></textarea>
                    </div>
                    <div class="form-check">
                        <input asp-for="Coupon.IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="Coupon.IsActive" class="form-check-label">Active</label>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">Discount</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Discount type</label>
                        <select asp-for="Coupon.DiscountType" class="form-select" id="discountTypeSelect">
                            <option value="Percentage">Percentage off</option>
                            <option value="FixedAmount">Fixed amount off</option>
                            <option value="FreeShipping">Free shipping</option>
                        </select>
                    </div>
                    <div class="row g-3" id="discountValueRow">
                        <div class="col-md-6">
                            <label class="form-label" id="discountValueLabel">Discount value</label>
                            <input asp-for="Coupon.DiscountValue" class="form-control" type="number" step="0.01" placeholder="e.g. 25" />
                            <span asp-validation-for="Coupon.DiscountValue" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Max discount amount</label>
                            <input asp-for="Coupon.MaxDiscountAmount" class="form-control" type="number" step="0.01" placeholder="Optional cap" />
                            <div class="form-text">Only applies to percentage discounts.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">Where it applies</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Scope</label>
                        <select asp-for="Coupon.Scope" class="form-select" id="scopeSelect">
                            <option value="Order">Entire order</option>
                            <option value="SpecificProducts">Specific products</option>
                            <option value="SpecificCategories">Specific categories</option>
                        </select>
                    </div>

                    <div class="mb-3" id="productsField" style="display:none;">
                        <label class="form-label">Products</label>
                        <select asp-for="Coupon.ProductIds" class="form-select" multiple size="8">
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">@product.Name</option>
                            }
                        </select>
                        <div class="form-text">Ctrl/Cmd+click to select multiple.</div>
                    </div>

                    <div class="mb-3" id="categoriesField" style="display:none;">
                        <label class="form-label">Categories</label>
                        <select asp-for="Coupon.CategoryIds" class="form-select" multiple size="8">
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <div class="form-text">Ctrl/Cmd+click to select multiple.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card mb-3">
                <div class="card-header fw-bold">Conditions</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Minimum order amount</label>
                        <input asp-for="Coupon.MinimumOrderAmount" class="form-control" type="number" step="0.01" placeholder="Optional" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Total usage limit</label>
                        <input asp-for="Coupon.UsageLimitTotal" class="form-control" type="number" min="1" placeholder="Optional — leave blank for unlimited" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Usage limit per customer</label>
                        <input asp-for="Coupon.UsageLimitPerUser" class="form-control" type="number" min="1" placeholder="Optional — leave blank for unlimited" />
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header fw-bold">Active window</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Start date</label>
                        <input asp-for="Coupon.StartDate" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                        <span asp-validation-for="Coupon.StartDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">End date</label>
                        <input asp-for="Coupon.EndDate" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" type="datetime-local" />
                        <div class="form-text">Leave blank for no expiry.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Create Coupon</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var scopeSelect = document.getElementById('scopeSelect');
            var productsField = document.getElementById('productsField');
            var categoriesField = document.getElementById('categoriesField');

            var discountTypeSelect = document.getElementById('discountTypeSelect');
            var discountValueRow = document.getElementById('discountValueRow');
            var discountValueLabel = document.getElementById('discountValueLabel');

            function syncScope() {
                var v = scopeSelect.value;
                productsField.style.display = v === 'SpecificProducts' ? '' : 'none';
                categoriesField.style.display = v === 'SpecificCategories' ? '' : 'none';
            }

            function syncDiscountType() {
                var v = discountTypeSelect.value;
                if (v === 'FreeShipping') {
                    discountValueRow.style.display = 'none';
                } else {
                    discountValueRow.style.display = '';
                    discountValueLabel.textContent = v === 'Percentage' ? 'Percentage (%)' : 'Amount off ($)';
                }
            }

            scopeSelect.addEventListener('change', syncScope);
            discountTypeSelect.addEventListener('change', syncDiscountType);

            syncScope();
            syncDiscountType();
        })();
    </script>
}