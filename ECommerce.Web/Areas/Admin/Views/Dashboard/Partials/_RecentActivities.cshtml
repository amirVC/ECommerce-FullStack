@model List<ECommerce.Web.DTOs.ActivityDto>

<div class="dashboard-card h-100">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="dashboard-card-title mb-0">

            <i class="bi bi-clock-history text-info"></i>

            Recent Activities

        </h4>

        <span class="badge bg-info">

            @Model.Count Activities

        </span>

    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-clock display-5 text-secondary"></i>

            <h5 class="mt-3">

                No Recent Activity

            </h5>

            <p class="text-muted">

                Everything is quiet.

            </p>

        </div>
    }
    else
    {
        <div class="activity-timeline">

            @foreach (var activity in Model)
            {
                <div class="activity-item">

                    <div class="activity-dot">

                        <i class="bi bi-circle-fill"></i>

                    </div>

                    <div class="activity-content">

                        <div class="fw-semibold">

                            @activity.Description

                        </div>

                        <small class="text-muted local-time"
                               data-utc="@activity.Date.ToString("o")">

                            @activity.Date.ToString("dd MMM yyyy • HH:mm")

                        </small>

                    </div>

                </div>
            }

        </div>
    }

</div>

<script>
    (function () {
        document.querySelectorAll('.local-time').forEach(function (el) {
            var utcValue = el.getAttribute('data-utc');
            if (!utcValue) return;

            var date = new Date(utcValue);
            if (isNaN(date.getTime())) return;

            var formatted = date.toLocaleString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            }).replace(',', ' •');

            el.textContent = formatted;
        });
    })();
</script>