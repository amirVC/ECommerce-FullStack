@model List<ECommerce.Web.DTOs.MonthlySalesDto>

<div class="dashboard-card dashboard-chart-card">

    <div class="dashboard-card-header">

        <div>

            <h4 class="dashboard-card-title">
                <i class="bi bi-graph-up-arrow text-success"></i>
                Monthly Revenue
            </h4>

            <small class="text-muted">
                Revenue overview for the last 12 months
            </small>

        </div>

        <span class="badge bg-success fs-6 px-3 py-2">
            Last 12 Months
        </span>

    </div>

    <hr />

    <div class="chart-wrapper">

        <canvas id="salesChart"></canvas>

    </div>

    <hr />

    <div class="d-flex justify-content-between align-items-center">

        <span class="text-muted">

            <i class="bi bi-arrow-up-right-circle-fill text-success"></i>

            Revenue Trend

        </span>

        <span class="fw-semibold text-success">

            Live Analytics

        </span>

    </div>

</div>