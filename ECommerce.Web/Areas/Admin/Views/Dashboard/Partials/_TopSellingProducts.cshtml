@model List<ECommerce.Web.DTOs.AdminTopSellingProductDto>

<div class="dashboard-card h-100">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h4 class="dashboard-card-title mb-0">

            <i class="bi bi-trophy-fill text-warning"></i>

            Top Selling Products

        </h4>

        <span class="badge bg-warning text-dark">

            Top @Model.Count

        </span>

    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">

            <i class="bi bi-box display-5"></i>

            <p class="mt-3 mb-0">
                No sales yet.
            </p>

        </div>
    }
    else
    {
        var maxSold = Model.Max(x => x.QuantitySold);

        @for (int i = 0; i < Model.Count; i++)
        {
            var item = Model[i];

            var percent = maxSold == 0
            ? 0
            : ((decimal)item.QuantitySold / maxSold) * 100;

            <div class="mb-4">

                <div class="d-flex justify-content-between">

                    <div>

                        <strong>

                            @(i == 0 ? "🥇"
                                                : i == 1 ? "🥈"
                                                : i == 2 ? "🥉"
                                                : "🏅")

                    @item.ProductName

                        </strong>

                    </div>

                    <span class="fw-bold">

                        @item.QuantitySold Sold

                    </span>

                </div>

                <div class="progress mt-2 dashboard-progress">

                    <div class="progress-bar"
                         style="width:@percent%">
                    </div>

                </div>

            </div>
        }
    }

</div>