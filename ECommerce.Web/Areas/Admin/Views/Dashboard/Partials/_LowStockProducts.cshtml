@model List<ECommerce.Web.DTOs.AdminLowStockProductDto>
<div class="dashboard-card h-100">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="dashboard-card-title mb-0">
            <i class="bi bi-exclamation-triangle-fill text-danger"></i>
            Low Stock Products
        </h4>
        <span class="badge bg-danger">
            @Model.Count Items
        </span>
    </div>
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-check-circle-fill display-5 text-success"></i>
            <h5 class="mt-3">
                Great!
            </h5>
            <p class="text-muted mb-0">
                No products need restocking.
            </p>
        </div>
    }
    else
    {
        @foreach (var product in Model)
        {
            var percent = Math.Min(product.Stock * 10, 100);
            var color =
            product.Stock <= 2
            ? "bg-danger"
            : product.Stock <= 5
            ? "bg-warning"
            : "bg-success";
            <div class="low-stock-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <strong>
                            @product.Name
                        </strong>
                        <br />
                        <small class="text-muted">
                            @product.Stock left in stock
                        </small>
                    </div>
                    <a asp-area="Admin"
                       asp-controller="Products"
                       asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="btn btn-icon btn-outline-primary"
                       title="Edit product">
                        <i class="bi bi-pencil"></i>
                    </a>
                </div>
                <div class="progress dashboard-progress mt-3">
                    <div class="progress-bar @color"
                         style="width:@percent%">
                    </div>
                </div>
            </div>
        }
    }
</div>
