@model List<ECommerce.Web.DTOs.AuditLogDto>
@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>🧾 Audit Logs</h2>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-2">
        <input type="text" name="logAction" value="@ViewBag.LogAction"
               class="form-control" placeholder="Action (e.g. LoginFailed)" />
    </div>
    <div class="col-md-2">
        <input type="text" name="entityName" value="@ViewBag.EntityName"
               class="form-control" placeholder="Entity (e.g. Order)" />
    </div>
    <div class="col-md-2">
        <input type="number" name="userId" value="@ViewBag.UserId"
               class="form-control" placeholder="User Id" />
    </div>
    <div class="col-md-2">
        <input type="date" name="fromDate" value="@ViewBag.FromDate"
               class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="toDate" value="@ViewBag.ToDate"
               class="form-control" />
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-bordered table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Time (UTC)</th>
            <th>User</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Details</th>
            <th>IP Address</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="6" class="text-center text-muted py-4">No audit log entries found.</td>
            </tr>
        }
        else
        {
            @foreach (var log in Model)
            {
                <tr>
                    <td class="small">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td>
                        @(log.UserEmail ?? "—")
                        @if (log.UserId.HasValue)
                        {
                            <div class="text-muted small">#@log.UserId</div>
                        }
                    </td>
                    <td><span class="badge bg-secondary">@log.Action</span></td>
                    <td class="small">
                        @log.EntityName
                        @if (!string.IsNullOrWhiteSpace(log.EntityId))
                        {
                            <text> #@log.EntityId</text>
                        }
                    </td>
                    <td class="small">@log.Details</td>
                    <td class="small text-muted">@log.IpAddress</td>
                </tr>
            }
        }
    </tbody>
</table>

@if ((int)(ViewBag.TotalPages ?? 1) > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == (int)ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-logAction="@ViewBag.LogAction"
                       asp-route-entityName="@ViewBag.EntityName"
                       asp-route-userId="@ViewBag.UserId"
                       asp-route-fromDate="@ViewBag.FromDate"
                       asp-route-toDate="@ViewBag.ToDate">@i</a>
                </li>
            }
        </ul>
    </nav>
}