@model ECommerce.Web.DTOs.CreateDeliveryMethodDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Add Delivery Method";
}

<div class="container-fluid" style="max-width: 640px;">

    <h2 class="mb-4">Add Delivery Method</h2>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input asp-for="Name" class="form-control" placeholder="Standard, Express..." />
        </div>

        <div class="mb-3">
            <label class="form-label">Description</label>
            <input asp-for="Description" class="form-control" placeholder="5–7 business days" />
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Min Days</label>
                <input asp-for="EstimatedDaysMin" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Max Days</label>
                <input asp-for="EstimatedDaysMax" class="form-control" type="number" min="0" />
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Sort Order</label>
            <input asp-for="SortOrder" class="form-control" type="number" />
        </div>

        <div class="form-check mb-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active (visible to customers at checkout)</label>
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>

</div>
