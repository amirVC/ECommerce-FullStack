@model ECommerce.Web.DTOs.CampaignDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Edit Campaign";

    var products = ViewBag.Products as IEnumerable<dynamic>
                   ?? Enumerable.Empty<dynamic>();

    var categories = ViewBag.Categories as IEnumerable<dynamic>
                     ?? Enumerable.Empty<dynamic>();
}

<div class="container-fluid px-0">

    <!-- Page Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>

                <div>
                    <h2 class="fw-bold mb-0">
                        Edit Campaign
                    </h2>

                    <p class="text-muted mb-0">
                        Update your automatic promotional campaign.
                    </p>
                </div>

            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="Campaigns"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Campaigns

        </a>

    </div>


    <!-- Error -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show
                        border-0 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <form asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="Id"
               value="@Model.Id" />

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>


        <div class="row g-4">

            <!-- ================================================= -->
            <!-- LEFT COLUMN -->
            <!-- ================================================= -->

            <div class="col-lg-8">


                <!-- Campaign Information -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-primary bg-opacity-10
                                        text-primary rounded-3 p-2">

                                <i class="bi bi-megaphone"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Campaign Information
                                </h5>

                                <small class="text-muted">
                                    Basic information about this promotion.
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <!-- Name -->
                        <div class="mb-4">

                            <label for="Name"
                                   class="form-label fw-semibold">

                                Campaign Name
                                <span class="text-danger">*</span>

                            </label>

                            <input name="Name"
                                   id="Name"
                                   value="@Model.Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Summer Sale"
                                   required />

                        </div>


                        <!-- Description -->
                        <div>

                            <label for="Description"
                                   class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea name="Description"
                                      id="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe this campaign...">@Model.Description</textarea>

                            <div class="form-text">
                                A short description helps administrators
                                understand the purpose of this campaign.
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Discount -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-success bg-opacity-10
                                        text-success rounded-3 p-2">

                                <i class="bi bi-percent"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Discount
                                </h5>

                                <small class="text-muted">
                                    Configure the automatic discount.
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">

                            <!-- Discount Type -->
                            <div class="col-md-6">

                                <label for="discountType"
                                       class="form-label fw-semibold">

                                    Discount Type

                                </label>

                                <select name="DiscountType"
                                        id="discountType"
                                        class="form-select form-select-lg">

                                    @if (Model.DiscountType == 1)
                                    {
                                        <option value="1" selected>
                                            Percentage
                                        </option>

                                        <option value="2">
                                            Fixed Amount
                                        </option>
                                    }
                                    else
                                    {
                                        <option value="1">
                                            Percentage
                                        </option>

                                        <option value="2" selected>
                                            Fixed Amount
                                        </option>
                                    }

                                </select>

                            </div>


                            <!-- Discount Value -->
                            <div class="col-md-6">

                                <label for="discountValue"
                                       class="form-label fw-semibold">

                                    Discount Value

                                </label>

                                <div class="input-group input-group-lg">

                                    <input name="DiscountValue"
                                           id="discountValue"
                                           value="@Model.DiscountValue"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           required />

                                    <span class="input-group-text fw-semibold"
                                          id="discountSymbol">

                                        @(Model.DiscountType == 1 ? "%" : "$")

                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Discount Preview -->
                        <div class="mt-4 p-3 rounded-3 bg-light border">

                            <div class="d-flex align-items-start gap-2">

                                <i class="bi bi-info-circle text-primary mt-1"></i>

                                <div>

                                    <div class="fw-semibold mb-1">
                                        Discount Preview
                                    </div>

                                    <div class="text-muted small"
                                         id="discountExample">

                                        @if (Model.DiscountType == 1)
                                        {
                                            <text>
                                                Customers will receive
                                                @Model.DiscountValue% off.
                                            </text>
                                        }
                                        else
                                        {
                                            <text>
                                                Customers will receive
                                                $@Model.DiscountValue off.
                                            </text>
                                        }

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Schedule -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-info bg-opacity-10
                                        text-info rounded-3 p-2">

                                <i class="bi bi-calendar-event"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Campaign Schedule
                                </h5>

                                <small class="text-muted">
                                    Choose when this campaign starts and ends.
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">

                            <!-- Start -->
                            <div class="col-md-6">

                                <label for="StartDate"
                                       class="form-label fw-semibold">

                                    Start Date & Time
                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-play-circle text-success"></i>
                                    </span>

                                    <input name="StartDate"
                                           id="StartDate"
                                           class="form-control"
                                           type="datetime-local"
                                           value="@Model.StartDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                                           required />

                                </div>

                                <div class="form-text">
                                    Campaign becomes available from this time.
                                </div>

                            </div>


                            <!-- End -->
                            <div class="col-md-6">

                                <label for="EndDate"
                                       class="form-label fw-semibold">

                                    End Date & Time
                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-stop-circle text-danger"></i>
                                    </span>

                                    <input name="EndDate"
                                           id="EndDate"
                                           class="form-control"
                                           type="datetime-local"
                                           value="@Model.EndDate.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")"
                                           required />

                                </div>

                                <div class="form-text">
                                    Campaign ends at this time.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- RIGHT COLUMN -->
            <!-- ================================================= -->

            <div class="col-lg-4">


                <!-- Status -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-warning bg-opacity-10
                                        text-warning rounded-3 p-2">

                                <i class="bi bi-toggle-on"></i>

                            </div>

                            <div>
                                <h5 class="fw-bold mb-0">
                                    Campaign Status
                                </h5>

                                <small class="text-muted">
                                    Control campaign availability.
                                </small>
                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div>

                                <div class="fw-semibold">
                                    Active Campaign
                                </div>

                                <small class="text-muted">
                                    Campaign can apply automatically
                                    during its schedule.
                                </small>

                            </div>


                            <div class="form-check form-switch mb-0">

                                <input type="checkbox"
                                       name="IsActive"
                                       value="true"
                                       class="form-check-input"
                                       role="switch"
                                       id="isActive"
                                       style="width: 2.8em; height: 1.4em;"
                                       @(Model.IsActive ? "checked" : "") />

                                <input type="hidden"
                                       name="IsActive"
                                       value="false" />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- Products -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div class="d-flex align-items-center gap-2">

                                <div class="bg-primary bg-opacity-10
                                            text-primary rounded-3 p-2">

                                    <i class="bi bi-box-seam"></i>

                                </div>

                                <div>
                                    <h5 class="fw-bold mb-0">
                                        Products
                                    </h5>

                                    <small class="text-muted">
                                        Select products
                                    </small>
                                </div>

                            </div>

                            <span class="badge bg-light text-dark border">
                                @Model.ProductIds.Count
                            </span>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="small text-muted mb-3">
                            Select products that should receive this campaign.
                        </div>

                        <div class="border rounded-3 p-3"
                             style="max-height: 280px; overflow-y: auto;">

                            @if (!products.Any())
                            {
                                <div class="text-center text-muted py-4">

                                    <i class="bi bi-box-seam fs-3 d-block mb-2"></i>

                                    No products available.

                                </div>
                            }
                            else
                            {
                                foreach (var product in products)
                                {
                                    var selected =
                                    Model.ProductIds.Contains(
                                    (int)product.Id);

                                    <div class="form-check mb-3">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="ProductIds"
                                               value="@product.Id"
                                               id="product_@product.Id"
                                               @(selected ? "checked" : "") />

                                        <label class="form-check-label"
                                               for="product_@product.Id">

                                            <span class="fw-medium">
                                                @product.Name
                                            </span>

                                        </label>

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>


                <!-- Categories -->
                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div class="d-flex align-items-center gap-2">

                                <div class="bg-secondary bg-opacity-10
                                            text-secondary rounded-3 p-2">

                                    <i class="bi bi-folder"></i>

                                </div>

                                <div>
                                    <h5 class="fw-bold mb-0">
                                        Categories
                                    </h5>

                                    <small class="text-muted">
                                        Select categories
                                    </small>
                                </div>

                            </div>

                            <span class="badge bg-light text-dark border">
                                @Model.CategoryIds.Count
                            </span>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="small text-muted mb-3">
                            All products inside selected categories
                            will receive this campaign.
                        </div>

                        <div class="border rounded-3 p-3"
                             style="max-height: 280px; overflow-y: auto;">

                            @if (!categories.Any())
                            {
                                <div class="text-center text-muted py-4">

                                    <i class="bi bi-folder fs-3 d-block mb-2"></i>

                                    No categories available.

                                </div>
                            }
                            else
                            {
                                foreach (var category in categories)
                                {
                                    var selected =
                                    Model.CategoryIds.Contains(
                                    (int)category.Id);

                                    <div class="form-check mb-3">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="CategoryIds"
                                               value="@category.Id"
                                               id="category_@category.Id"
                                               @(selected ? "checked" : "") />

                                        <label class="form-check-label"
                                               for="category_@category.Id">

                                            <span class="fw-medium">
                                                @category.Name
                                            </span>

                                        </label>

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>


                <!-- Save Actions -->
                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 mb-2">

                            <i class="bi bi-check-lg me-1"></i>
                            Save Changes

                        </button>

                        <a asp-area="Admin"
                           asp-controller="Campaigns"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            <i class="bi bi-x-lg me-1"></i>
                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const discountType =
            document.getElementById("discountType");

        const discountValue =
            document.getElementById("discountValue");

        const discountSymbol =
            document.getElementById("discountSymbol");

        const discountExample =
            document.getElementById("discountExample");


        function updateDiscountUI() {

            const value =
                parseFloat(discountValue.value) || 0;


            if (discountType.value === "1") {

                discountSymbol.textContent = "%";

                discountExample.textContent =
                    value > 0
                        ? `Customers will receive ${value}% off.`
                        : "Customers will receive a percentage discount.";

            }
            else {

                discountSymbol.textContent = "$";

                discountExample.textContent =
                    value > 0
                        ? `Customers will receive $${value} off.`
                        : "Customers will receive a fixed amount discount.";

            }

        }


        discountType.addEventListener(
            "change",
            updateDiscountUI
        );

        discountValue.addEventListener(
            "input",
            updateDiscountUI
        );


        updateDiscountUI();

    </script>
}