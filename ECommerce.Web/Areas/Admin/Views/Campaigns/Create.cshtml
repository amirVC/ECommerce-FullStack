@model ECommerce.Web.DTOs.AdminCreateCampaignDto

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Campaign";

    // Create GET currently returns View() without a model,
    // so use a safe default model.
    var model = Model ?? new ECommerce.Web.DTOs.AdminCreateCampaignDto();

    var products = ViewBag.Products;
    var categories = ViewBag.Categories;
}

<div class="container-fluid px-0">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>

            <div class="d-flex align-items-center gap-2 mb-1">

                <div class="bg-primary bg-opacity-10
                            text-primary rounded-3 p-2">

                    <i class="bi bi-megaphone-fill fs-5"></i>

                </div>

                <div>

                    <h2 class="fw-bold mb-0">
                        Create Campaign
                    </h2>

                    <p class="text-muted mb-0">
                        Create an automatic promotional campaign.
                    </p>

                </div>

            </div>

        </div>


        <a asp-area="Admin"
           asp-controller="Campaigns"
           asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Campaigns

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================================= -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show
                        border-0 shadow-sm"
             role="alert">

            <i class="bi bi-exclamation-triangle-fill me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- VALIDATION -->
    <!-- ========================================================= -->

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()


        <div class="row g-4">


            <!-- ================================================= -->
            <!-- LEFT COLUMN -->
            <!-- ================================================= -->

            <div class="col-lg-8">


                <!-- ================================================= -->
                <!-- CAMPAIGN INFORMATION -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-primary bg-opacity-10
                                        text-primary rounded-3 p-2">

                                <i class="bi bi-megaphone"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Campaign Information
                                </h5>

                                <small class="text-muted">
                                    Basic information about your promotion.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <!-- Name -->

                        <div class="mb-4">

                            <label for="Name"
                                   class="form-label fw-semibold">

                                Campaign Name

                                <span class="text-danger">*</span>

                            </label>

                            <input asp-for="Name"
                                   id="Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Summer Sale"
                                   required />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- Description -->

                        <div>

                            <label for="Description"
                                   class="form-label fw-semibold">

                                Description

                            </label>

                            <textarea asp-for="Description"
                                      id="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe this campaign..."></textarea>

                            <div class="form-text">

                                A short description helps administrators
                                understand the purpose of this campaign.

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- DISCOUNT -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-success bg-opacity-10
                                        text-success rounded-3 p-2">

                                <i class="bi bi-percent"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Discount
                                </h5>

                                <small class="text-muted">
                                    Configure the automatic discount.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">


                            <!-- Discount Type -->

                            <div class="col-md-6">

                                <label for="discountType"
                                       class="form-label fw-semibold">

                                    Discount Type

                                </label>

                                <select asp-for="DiscountType"
                                        id="discountType"
                                        class="form-select form-select-lg">

                                    <option value="1">
                                        Percentage
                                    </option>

                                    <option value="2">
                                        Fixed Amount
                                    </option>

                                </select>

                            </div>


                            <!-- Discount Value -->

                            <div class="col-md-6">

                                <label for="discountValue"
                                       class="form-label fw-semibold">

                                    Discount Value

                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group input-group-lg">

                                    <input asp-for="DiscountValue"
                                           id="discountValue"
                                           class="form-control"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           placeholder="20"
                                           required />

                                    <span class="input-group-text fw-semibold"
                                          id="discountSymbol">

                                        %

                                    </span>

                                </div>

                                <span asp-validation-for="DiscountValue"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>


                        <!-- Discount Preview -->

                        <div class="mt-4 p-3 rounded-3 bg-light border">

                            <div class="d-flex align-items-start gap-2">

                                <i class="bi bi-info-circle text-primary mt-1"></i>

                                <div>

                                    <div class="fw-semibold mb-1">
                                        Discount Preview
                                    </div>

                                    <div class="text-muted small"
                                         id="discountExample">

                                        Customers will receive
                                        a percentage discount.

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SCHEDULE -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-info bg-opacity-10
                                        text-info rounded-3 p-2">

                                <i class="bi bi-calendar-event"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Campaign Schedule
                                </h5>

                                <small class="text-muted">
                                    Choose when this campaign starts and ends.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="row g-3">


                            <!-- Start -->

                            <div class="col-md-6">

                                <label for="StartDate"
                                       class="form-label fw-semibold">

                                    Start Date & Time

                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-play-circle text-success"></i>

                                    </span>

                                    <input asp-for="StartDate"
                                           id="StartDate"
                                           class="form-control"
                                           type="datetime-local"
                                           required />

                                </div>

                                <div class="form-text">

                                    Campaign becomes available from this time.

                                </div>

                                <span asp-validation-for="StartDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- End -->

                            <div class="col-md-6">

                                <label for="EndDate"
                                       class="form-label fw-semibold">

                                    End Date & Time

                                    <span class="text-danger">*</span>

                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-stop-circle text-danger"></i>

                                    </span>

                                    <input asp-for="EndDate"
                                           id="EndDate"
                                           class="form-control"
                                           type="datetime-local"
                                           required />

                                </div>

                                <div class="form-text">

                                    Campaign ends at this time.

                                </div>

                                <span asp-validation-for="EndDate"
                                      class="text-danger small">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- RIGHT COLUMN -->
            <!-- ================================================= -->

            <div class="col-lg-4">


                <!-- ================================================= -->
                <!-- STATUS -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex align-items-center gap-2">

                            <div class="bg-warning bg-opacity-10
                                        text-warning rounded-3 p-2">

                                <i class="bi bi-toggle-on"></i>

                            </div>

                            <div>

                                <h5 class="fw-bold mb-0">
                                    Campaign Status
                                </h5>

                                <small class="text-muted">
                                    Control campaign availability.
                                </small>

                            </div>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div>

                                <div class="fw-semibold">
                                    Active Campaign
                                </div>

                                <small class="text-muted">
                                    Campaign can apply automatically
                                    during its schedule.
                                </small>

                            </div>


                            <div class="form-check form-switch mb-0">

                                <input asp-for="IsActive"
                                       class="form-check-input"
                                       role="switch"
                                       id="isActive"
                                       style="width: 2.8em; height: 1.4em;" />

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- PRODUCTS -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div class="d-flex align-items-center gap-2">

                                <div class="bg-primary bg-opacity-10
                                            text-primary rounded-3 p-2">

                                    <i class="bi bi-box-seam"></i>

                                </div>

                                <div>

                                    <h5 class="fw-bold mb-0">
                                        Products
                                    </h5>

                                    <small class="text-muted">
                                        Select products
                                    </small>

                                </div>

                            </div>

                            <span class="badge bg-light text-dark border"
                                  id="productCount">

                                0

                            </span>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="small text-muted mb-3">

                            Select products that should receive
                            this campaign.

                        </div>


                        <div class="border rounded-3 p-3"
                             style="max-height: 280px; overflow-y: auto;">

                            @if (products == null)
                            {
                                <div class="text-center text-muted py-4">

                                    <i class="bi bi-box-seam fs-3 d-block mb-2"></i>

                                    No products available.

                                </div>
                            }
                            else
                            {
                                foreach (var product in products)
                                {
                                    <div class="form-check mb-3">

                                        <input class="form-check-input campaign-product"
                                               type="checkbox"
                                               name="ProductIds"
                                               value="@product.Id"
                                               id="product_@product.Id" />

                                        <label class="form-check-label"
                                               for="product_@product.Id">

                                            <span class="fw-medium">
                                                @product.Name
                                            </span>

                                        </label>

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- CATEGORIES -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white border-0 py-3">

                        <div class="d-flex justify-content-between
                                    align-items-center">

                            <div class="d-flex align-items-center gap-2">

                                <div class="bg-secondary bg-opacity-10
                                            text-secondary rounded-3 p-2">

                                    <i class="bi bi-folder"></i>

                                </div>

                                <div>

                                    <h5 class="fw-bold mb-0">
                                        Categories
                                    </h5>

                                    <small class="text-muted">
                                        Select categories
                                    </small>

                                </div>

                            </div>

                            <span class="badge bg-light text-dark border"
                                  id="categoryCount">

                                0

                            </span>

                        </div>

                    </div>


                    <div class="card-body">

                        <div class="small text-muted mb-3">

                            All products inside selected categories
                            will receive this campaign.

                        </div>


                        <div class="border rounded-3 p-3"
                             style="max-height: 280px; overflow-y: auto;">

                            @if (categories == null)
                            {
                                <div class="text-center text-muted py-4">

                                    <i class="bi bi-folder fs-3 d-block mb-2"></i>

                                    No categories available.

                                </div>
                            }
                            else
                            {
                                foreach (var category in categories)
                                {
                                    <div class="form-check mb-3">

                                        <input class="form-check-input campaign-category"
                                               type="checkbox"
                                               name="CategoryIds"
                                               value="@category.Id"
                                               id="category_@category.Id" />

                                        <label class="form-check-label"
                                               for="category_@category.Id">

                                            <span class="fw-medium">
                                                @category.Name
                                            </span>

                                        </label>

                                    </div>
                                }
                            }

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- SAVE -->
                <!-- ================================================= -->

                <div class="card border-0 shadow-sm">

                    <div class="card-body">

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 mb-2">

                            <i class="bi bi-check-lg me-1"></i>

                            Create Campaign

                        </button>


                        <a asp-area="Admin"
                           asp-controller="Campaigns"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            <i class="bi bi-x-lg me-1"></i>

                            Cancel

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // =========================================================
        // DISCOUNT UI
        // =========================================================

        const discountType =
            document.getElementById("discountType");

        const discountValue =
            document.getElementById("discountValue");

        const discountSymbol =
            document.getElementById("discountSymbol");

        const discountExample =
            document.getElementById("discountExample");


        function updateDiscountUI() {

            const value =
                parseFloat(discountValue.value) || 0;


            if (discountType.value === "1") {

                discountSymbol.textContent = "%";

                discountExample.textContent =
                    value > 0
                        ? `Customers will receive ${value}% off.`
                        : "Customers will receive a percentage discount.";

            }
            else {

                discountSymbol.textContent = "$";

                discountExample.textContent =
                    value > 0
                        ? `Customers will receive $${value} off.`
                        : "Customers will receive a fixed amount discount.";

            }

        }


        discountType.addEventListener(
            "change",
            updateDiscountUI
        );


        discountValue.addEventListener(
            "input",
            updateDiscountUI
        );


        updateDiscountUI();


        // =========================================================
        // PRODUCT / CATEGORY COUNTERS
        // =========================================================

        const productCheckboxes =
            document.querySelectorAll(".campaign-product");

        const categoryCheckboxes =
            document.querySelectorAll(".campaign-category");


        const productCount =
            document.getElementById("productCount");

        const categoryCount =
            document.getElementById("categoryCount");


        function updateProductCount() {

            const count =
                document.querySelectorAll(
                    ".campaign-product:checked"
                ).length;

            productCount.textContent = count;

        }


        function updateCategoryCount() {

            const count =
                document.querySelectorAll(
                    ".campaign-category:checked"
                ).length;

            categoryCount.textContent = count;

        }


        productCheckboxes.forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    updateProductCount
                );

            }
        );


        categoryCheckboxes.forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    updateCategoryCount
                );

            }
        );


        updateProductCount();
        updateCategoryCount();

    </script>
}