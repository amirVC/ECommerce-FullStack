@model List<ECommerce.Web.DTOs.AdminOrderDto>

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Orders";

    string PaymentBadgeClass(string? status) => status?.ToLowerInvariant() switch
    {
        "paid" => "bg-success",
        "pending" => "bg-warning text-dark",
        "failed" => "bg-danger",
        "refunded" => "bg-secondary",
        "partiallyrefunded" => "bg-secondary",
        "canceled" or "cancelled" => "bg-dark",
        _ => "bg-secondary"
    };

    var orders = Model
        .OrderByDescending(o => o.CreatedAt)
        .ToList();
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Orders</h2>
            <p class="text-muted">Manage customer orders.</p>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Orders</h5>
        </div>

        <div class="card-body">
            @if (orders.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    No orders found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Customer</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Payment</th>
                                <th>Order Date</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (var i = 0; i < orders.Count; i++)
                            {
                                var order = orders[i];

                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.ItemCount</td>
                                    <td>@order.TotalPrice.ToString("C")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @PaymentBadgeClass(order.PaymentStatus)">
                                            @order.PaymentStatus
                                        </span>
                                    </td>
                                    <td>
                                        @order.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                    </td>
                                    <td>
                                        <a href="@Url.Action("Details", "Orders", new { area = "Admin", publicId = order.PublicId })"
                                           class="btn btn-primary btn-sm">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
