@model List<ECommerce.Web.DTOs.RecentlyViewedDto>

@{
    ViewData["Title"] = "Recently Viewed";
}

<div class="container mt-5 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">Recently Viewed</h1>

        @if (Model.Any())
        {
            <form asp-action="Clear" method="post" onsubmit="return confirm('Clear your recently viewed history?');">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash me-1"></i> Clear History
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-clock-history display-4 d-block mb-3"></i>
            You haven't viewed any products yet.
            <div class="mt-3">
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary">Browse Products</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-3">
                    <div class="card h-100 border-0 shadow-sm related-product-card">
                        <div class="overflow-hidden rounded-top-4 bg-light d-flex align-items-center justify-content-center p-2" style="height: 200px;">
                            @{
                                var rvImage = string.IsNullOrWhiteSpace(item.ThumbnailUrl)
                                ? item.ImageUrl
                                : item.ThumbnailUrl;
                            }
                            <img src="@(string.IsNullOrWhiteSpace(rvImage) ? "https://placehold.co/600x400?text=No+Image" : rvImage)"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                 loading="lazy">
                        </div>
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fs-6 fw-semibold">@item.Name</h5>
                            @if (item.ReviewCount > 0)
                            {
                                <div class="text-warning small mb-1">
                                    @{
                                        var full = (int)Math.Round(item.AverageRating);
                                    }
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= full ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                    <span class="text-muted">(@item.ReviewCount)</span>
                                </div>
                            }
                            <p class="card-text text-primary fw-bold mb-3">@item.Price.ToString("C")</p>
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm mt-auto">
                                View Product
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .related-product-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

        .related-product-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 0.75rem 1.5rem rgba(0, 0, 0, 0.1) !important;
        }

    .rounded-top-4 {
        border-top-left-radius: 0.75rem;
        border-top-right-radius: 0.75rem;
    }
</style>