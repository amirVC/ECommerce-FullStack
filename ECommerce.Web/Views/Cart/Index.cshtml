
@model ECommerce.Web.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Your Cart";
}

<h2 class="mb-4">Your Cart</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["Success"]
    </div>
}

@if (!Model.Items.Any())
{
    <div class="text-center py-5">
        <p class="fs-5 text-muted">Your cart is empty.</p>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Continue Shopping
        </a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th></th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr id="cart-row-@item.PublicId">
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @{
                                    var itemImage =
                                    string.IsNullOrWhiteSpace(item.ThumbnailUrl)
                                    ? item.ImageUrl
                                    : item.ThumbnailUrl;
                                }

                                @if (!string.IsNullOrEmpty(itemImage))
                                {
                                    <img src="@itemImage"
                                         alt="@item.ProductName"
                                         style="width:60px;height:60px;object-fit:cover;"
                                         class="rounded" />
                                }

                                <span>@item.ProductName</span>
                            </div>
                        </td>

                        <td>
                            @if (item.IsOnSale)
                            {
                                <span class="text-muted text-decoration-line-through small d-block">
                                    @item.OriginalPrice.ToString("C")
                                </span>

                                <span class="text-danger fw-bold">
                                    @item.Price.ToString("C")
                                </span>
                            }
                            else
                            {
                                @item.Price.ToString("C")
                            }
                        </td>

                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <form asp-controller="Cart"
                                      asp-action="Decrease"
                                      method="post"
                                      class="m-0">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="publicId"
                                           value="@item.PublicId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary"
                                            aria-label="Decrease quantity">
                                        −
                                    </button>
                                </form>

                                <span>@item.Quantity</span>

                                <form asp-controller="Cart"
                                      asp-action="Increase"
                                      method="post"
                                      class="m-0">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="publicId"
                                           value="@item.PublicId" />

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary"
                                            aria-label="Increase quantity">
                                        +
                                    </button>
                                </form>
                            </div>
                        </td>

                        <td>@item.Total.ToString("C")</td>

                        <td>
                            <form asp-controller="Cart"
                                  asp-action="Remove"
                                  method="post"
                                  class="m-0">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="publicId"
                                       value="@item.PublicId" />

                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-start mt-4">
        <form asp-controller="Cart"
              asp-action="Clear"
              method="post"
              class="m-0"
              onsubmit="return confirm('Are you sure you want to clear your cart?');">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-outline-secondary">
                Clear Cart
            </button>
        </form>

        <div class="text-end" style="min-width:320px;">
            @if (Model.CanApplyCoupon)
            {
                if (string.IsNullOrEmpty(Model.AppliedCouponCode))
                {
                    <form asp-controller="Cart"
                          asp-action="ApplyCoupon"
                          method="post"
                          class="d-flex gap-2 mb-3 justify-content-end">

                        @Html.AntiForgeryToken()

                        <input type="text"
                               name="code"
                               class="form-control"
                               style="max-width:200px;"
                               placeholder="Coupon code"
                               required />

                        <button type="submit"
                                class="btn btn-outline-primary">
                            Apply
                        </button>
                    </form>
                }
                else
                {
                    <div class="d-flex justify-content-end align-items-center gap-2 mb-3">
                        <span class="badge bg-success">
                            Coupon "@Model.AppliedCouponCode" applied
                        </span>

                        <form asp-controller="Cart"
                              asp-action="RemoveCoupon"
                              method="post"
                              class="m-0">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="btn btn-sm btn-link text-danger">
                                Remove
                            </button>
                        </form>
                    </div>
                }
            }
            else
            {
                <div class="text-muted small mb-3">
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="@Url.Action("Index", "Cart")">
                        Log in
                    </a>
                    to use a coupon code.
                </div>
            }

            <div class="d-flex justify-content-between">
                <span>Subtotal</span>
                <span>@Model.Subtotal.ToString("C")</span>
            </div>

            @if (Model.SaleDiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-success">
                    <span>Sale Discount</span>
                    <span>-@Model.SaleDiscountAmount.ToString("C")</span>
                </div>
            }

            @if (Model.CampaignDiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-success">
                    <span>Campaign Discount</span>
                    <span>-@Model.CampaignDiscountAmount.ToString("C")</span>
                </div>
            }

            @if (Model.DiscountAmount > 0)
            {
                <div class="d-flex justify-content-between text-success">
                    <span>
                        Coupon Discount

                        @if (!string.IsNullOrEmpty(Model.AppliedCouponCode))
                        {
                            <span class="small">
                                (@Model.AppliedCouponCode)
                            </span>
                        }
                    </span>

                    <span>-@Model.DiscountAmount.ToString("C")</span>
                </div>
            }

            @if (Model.FreeShippingApplied)
            {
                <div class="text-success small">
                    Free shipping applied at checkout
                </div>
            }

            <h4 class="d-flex justify-content-between mt-2">
                <span>Total</span>
                <span>@Model.Total.ToString("C")</span>
            </h4>

            <a asp-controller="Checkout"
               asp-action="Index"
               class="btn btn-success btn-lg mt-2">
                Checkout
            </a>
        </div>
    </div>
}