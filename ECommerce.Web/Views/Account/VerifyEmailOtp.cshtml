@model ECommerce.Web.ViewModels.VerifyCodeViewModel
@{
    ViewData["Title"] = "Check Your Email";
}
<div class="container mt-5" style="max-width:500px;">
    <h2 class="mb-3">Check Your Email</h2>
    <p class="text-muted mb-4">
        We've sent a 6-digit code to
        @if (ViewBag.MaskedEmail != null)
        {
            <strong>@ViewBag.MaskedEmail</strong>
        }
        else
        {
            <span>your email address</span>
        }
.
        Enter it below to continue signing in. The code expires in 10 minutes.
    </p>
    <form asp-action="VerifyEmailOtp" method="post">
        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
        <input type="hidden" asp-for="ChallengeToken" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="Code" class="form-label">Verification code</label>
            <input asp-for="Code"
                   class="form-control"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   maxlength="6"
                   autofocus />
            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <button class="btn btn-dark w-100">
            Continue
        </button>
        <div class="text-center mt-3">
            <a asp-controller="Account" asp-action="Login">
                Back to login
            </a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
