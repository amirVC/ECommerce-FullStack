@model List<ECommerce.Web.DTOs.AddressDto>

@{
    ViewData["Title"] = "My Addresses";
}

<div class="container my-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Addresses</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add Address</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <p class="text-muted">You haven't saved any addresses yet.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var address in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm @(address.IsDefault ? "border-primary" : "")">
                        <div class="card-body">
                            @if (address.IsDefault)
                            {
                                <span class="badge bg-primary mb-2">Default</span>
                            }
                            <h5 class="card-title">@address.FullName</h5>
                            <p class="card-text mb-1">@address.Phone</p>
                            <p class="card-text mb-1">
                                @address.Line1
                                @if (!string.IsNullOrWhiteSpace(address.Line2))
                                {
                                    <br />@address.Line2
                                }
                            </p>
                            <p class="card-text mb-3">
                                @address.City, @address.State @address.PostalCode<br />
                                @address.Country
                            </p>

                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@address.Id" class="btn btn-sm btn-outline-secondary">Edit</a>

                                @if (!address.IsDefault)
                                {
                                    <form asp-action="SetDefault" asp-route-id="@address.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Make default</button>
                                    </form>
                                }

                                <form asp-action="Delete" asp-route-id="@address.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this address?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
