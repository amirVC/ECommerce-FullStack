@model ECommerce.Web.ViewModels.ProductCatalogViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <!-- Hero Section -->

    <div class="py-5 text-center">

        <h1 class="display-3 fw-bold">
            Discover Amazing Products
        </h1>

        <p class="lead text-secondary mt-3">
            Shop the latest technology, fashion, and accessories
            at unbeatable prices.
        </p>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-dark btn-lg mt-3">

            Shop Now

        </a>

    </div>


    <!-- Featured Products -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="fw-bold">
            Featured Products
        </h2>

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-outline-dark">

            View All Products

        </a>

    </div>


    <div class="row">

        @foreach (var product in Model.Products.Items.Take(6))
        {
            <div class="col-lg-4 col-md-6 mb-4">

                <div class="card shadow-sm h-100 position-relative">

                    <!-- DISCOUNT BADGES -->
                    @if (product.HasAnyDiscount)
                    {
                        <div class="position-absolute top-0 start-0 p-2"
                             style="z-index: 2;">

                            @if (product.IsOnSale)
                            {
                                <span class="badge bg-danger me-1">
                                    SALE
                                </span>
                            }

                            @if (product.HasCampaign)
                            {
                                <span class="badge bg-success">
                                    CAMPAIGN
                                </span>
                            }

                        </div>
                    }


                    <!-- Product Image -->
                    @if (string.IsNullOrWhiteSpace(product.ImageUrl))
                    {
                        <img src="https://placehold.co/600x400?text=No+Image"
                             class="card-img-top"
                             alt="No Image" />
                    }
                    else
                    {
                        <img src="@product.ImageUrl"
                             class="card-img-top"
                             alt="@product.Name" />
                    }


                    <div class="card-body">

                        <!-- Category -->

                        <span class="badge bg-secondary mb-2">
                            @product.CategoryName
                        </span>


                        <!-- Product Name -->

                        <h5 class="card-title">
                            @product.Name
                        </h5>


                        <!-- Price -->

                        <div class="mt-3">

                            @if (product.HasAnyDiscount)
                            {
                                <!-- Original Price -->

                                <div>

                                    <span class="text-muted text-decoration-line-through">

                                        @product.Price.ToString("C")

                                    </span>

                                </div>


                                <!-- Final Price -->

                                <div>

                                    <span class="text-danger fw-bold fs-4">

                                        @product.FinalPrice.ToString("C")

                                    </span>

                                </div>


                                <!-- Discount -->

                                <div class="mt-1">

                                    <span class="badge bg-danger">

                                        Save
                                        @product.TotalDiscountAmount.ToString("C")

                                    </span>

                                    @if (product.TotalDiscountPercentage > 0)
                                    {
                                        <span class="badge bg-warning text-dark">

                                            @product.TotalDiscountPercentage% OFF

                                        </span>
                                    }

                                </div>


                                <!-- Campaign -->
                                @if (product.HasCampaign &&
                                                        !string.IsNullOrWhiteSpace(
                                                        product.CampaignName))
                                {
                                    <div class="small text-success mt-2">

                                        @product.CampaignName

                                    </div>
                                }
                            }
                            else
                            {
                                <!-- Normal Price -->

                                <span class="text-primary fw-bold fs-4">

                                    @product.Price.ToString("C")

                                </span>
                            }

                        </div>


                        <!-- Stock -->
                        @if (product.Stock > 0)
                        {
                            <p class="text-success mt-2 mb-0">

                                ✔ In Stock

                            </p>
                        }
                        else
                        {
                            <p class="text-danger mt-2 mb-0">

                                ✖ Out of Stock

                            </p>
                        }

                    </div>


                    <!-- Actions -->

                    <div class="card-footer bg-white border-0">

                        <div class="d-grid gap-2">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-dark">

                                View Details

                            </a>


                            <a asp-controller="Cart"
                               asp-action="Add"
                               asp-route-id="@product.Id"
                               class="btn btn-success">

                                Add to Cart

                            </a>


                            @{
                                var isWishlisted =
                                Model.WishlistedProductIds.Contains(
                                product.Id);
                            }

                            <button type="button"
                                    data-product-id="@product.Id"
                                    class="btn @(isWishlisted
                                                                            ? "btn-danger"
                                                                            : "btn-outline-secondary")"
                                                                                                      onclick="toggleWishlistCard(this)">

                                <span class="wl-icon">

                                    @(isWishlisted
                                                                    ? "❤️"
                                                                    : "🤍")

                                </span>

                                <span class="wl-text">

                                    @(isWishlisted
                                                                    ? "Remove from Wishlist"
                                                                    : "Add to Wishlist")

                            </span>

                            </button>

                        </div>

                    </div>

                </div>

            </div>
                }

    </div>


    <!-- View All -->

    <div class="text-center mt-4 mb-5">

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-lg btn-outline-dark">

            View All Products

        </a>

    </div>

</div>


@section Scripts {

    <script>

        async function toggleWishlistCard(btn) {

            const productId =
                btn.dataset.productId;

            btn.disabled = true;

            try {

                const response =
                    await fetch(
                        '/Wishlist/ToggleAjax',
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type':
                                    'application/x-www-form-urlencoded'
                            },
                            body:
                                `productId=${productId}`
                        }
                    );


                if (response.status === 401) {

                    window.location.href =
                        '/Account/Login?returnUrl=' +
                        encodeURIComponent(
                            window.location.pathname
                        );

                    return;
                }


                const data =
                    await response.json();


                const icon =
                    btn.querySelector('.wl-icon');

                const text =
                    btn.querySelector('.wl-text');


                if (data.success) {

                    if (data.isWishlisted) {

                        icon.textContent = '❤️';

                        text.textContent =
                            'Remove from Wishlist';

                        btn.classList.replace(
                            'btn-outline-secondary',
                            'btn-danger'
                        );

                    }
                    else {

                        icon.textContent = '🤍';

                        text.textContent =
                            'Add to Wishlist';

                        btn.classList.replace(
                            'btn-danger',
                            'btn-outline-secondary'
                        );
                    }


                    updateWishlistBadge(
                        data.isWishlisted
                    );

                }
                else {

                    alert(
                        data.message ||
                        'Something went wrong.'
                    );
                }

            }
            catch (err) {

                alert(
                    'Network error, please try again.'
                );

            }
            finally {

                btn.disabled = false;
            }
        }

    </script>
}